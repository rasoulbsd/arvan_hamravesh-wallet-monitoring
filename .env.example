# ArvanCloud
ARVAN_EMAIL=your_arvancloud_email@example.com
ARVAN_PASSWORD=your_arvancloud_password
ARVAN_WALLET_THRESHOLD=1000000
ARVAN_TELEGRAM_BOT_TOKEN=your_arvancloud_telegram_bot_token
ARVAN_TELEGRAM_CHAT_ID=your_arvancloud_telegram_chat_id
ARVAN_TELEGRAM_TOPIC_ID=your_arvancloud_telegram_topic_id
# Telegram low-balance + check-failure alerts: edit last message (default) or always send new
# ARVAN_TELEGRAM_NOTIFY_MODE=edit
# ARVAN_TELEGRAM_NOTIFY_MODE=new
ARVAN_CHECK_INTERVAL_HOURS=6

# Optional SOCKS5 for provider APIs and Hamravesh Playwright (proxy-chain relay; auth OK)
SOCKS5_PROXY_URL=socks5://username:password@127.0.0.1:1080
# HTTP for Arvan/Hamravesh APIs: auto = direct then SOCKS | direct = never SOCKS | proxy = SOCKS only
PROVIDER_HTTP_MODE=auto
# Playwright browser: same values; falls back to PROVIDER_HTTP_MODE if unset
# PLAYWRIGHT_PROXY_MODE=auto
# Optional debug mode (runs immediately once with verbose logs)
DEBUG_MODE=false
# Base delay before retrying after errors (prevents request storms)
RETRY_BASE_DELAY_SECONDS=300
# Axios timeout (ms) for Arvan/Hamravesh provider APIs
HTTP_REQUEST_TIMEOUT_MS=120000
# Per schedule: up to N full tries; each try = direct HTTP then SOCKS5 if SOCKS5_PROXY_URL is set; then Telegram if all fail
CHECK_MAX_ATTEMPTS=3

# Hamravesh
HAMRAVESH_EMAIL=your_hamravesh_email@example.com
HAMRAVESH_PASSWORD=your_hamravesh_password
# Optional: JWT from browser cookie `user` (Console). Takes precedence over parsing HAMRAVESH_COOKIE.
HAMRAVESH_ACCESS_TOKEN=
# Optional: full Cookie header from DevTools (must include user=… JWT, not only analytics cookies).
HAMRAVESH_COOKIE=
# Optional: path to a file whose contents are the Cookie header (single line).
# HAMRAVESH_COOKIE_FILE=hamravesh/cookie.txt
# Optional: Playwright storageState JSON from: npm run hamravesh:export-session (used if HAMRAVESH_COOKIE is empty).
# HAMRAVESH_PLAYWRIGHT_STORAGE=hamravesh/playwright-storage.json
# Automated export: headless Chromium (false = show browser window)
HAMRAVESH_PLAYWRIGHT_HEADLESS=true
PLAYWRIGHT_NAV_TIMEOUT_MS=180000
PLAYWRIGHT_ACTION_TIMEOUT_MS=90000
HAMRAVESH_EXPORT_MAX_ATTEMPTS=3
HAMRAVESH_EXPORT_RETRY_DELAY_MS=10000
# PLAYWRIGHT_NO_SANDBOX=true
# Optional: browser User-Agent when using cookies (default: Firefox on Windows).
# HAMRAVESH_USER_AGENT=
# Optional: override API host (default https://api.hamravesh.com). Do not use console.hamravesh.com — it is the SPA, not the JSON API.
# HAMRAVESH_API_BASE_URL=https://api.hamravesh.com
# Override full URLs from DevTools if Hamravesh moved endpoints:
# HAMRAVESH_LOGIN_URL=
# HAMRAVESH_PROFILE_URL=
# Skip password login; use Playwright session or COOKIE only (recommended if /users/login is 404):
# HAMRAVESH_MANUAL_AUTH_ONLY=true
# With manual auth: run Playwright from the monitor when JWT missing / 401 (set false to only use npm run hamravesh:export-session)
# HAMRAVESH_PLAYWRIGHT_INTEGRATED=true
# Retries for login submit when page does not redirect (slow proxy)
# HAMRAVESH_LOGIN_SUBMIT_RETRIES=3
# No API: edit hamravesh/manual-balance.json and enable:
# HAMRAVESH_USE_MANUAL_BALANCE_FILE=false
# HAMRAVESH_MANUAL_BALANCE_FILE=manual-balance.json
HAMRAVESH_WALLET_THRESHOLD=1000000
HAMRAVESH_TELEGRAM_BOT_TOKEN=your_hamravesh_telegram_bot_token
HAMRAVESH_TELEGRAM_CHAT_ID=your_hamravesh_telegram_chat_id
HAMRAVESH_TELEGRAM_TOPIC_ID=your_hamravesh_telegram_topic_id
# Telegram low-balance + check-failure alerts: edit last message (default) or always send new
# HAMRAVESH_TELEGRAM_NOTIFY_MODE=edit
# HAMRAVESH_TELEGRAM_NOTIFY_MODE=new
HAMRAVESH_CHECK_INTERVAL_HOURS=6