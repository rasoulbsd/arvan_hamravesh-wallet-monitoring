{
  "name": "arvan_hamravesh-wallet-monitoring",
  "version": "1.0.0",
  "description": "Monitors ArvanCloud and Hamravesh wallet balances and sends Telegram alerts for low balances.",
  "main": "arvan/arvan-wallet-check.js",
  "type": "module",
  "scripts": {
    "start:arvan": "node arvan/arvan-wallet-check.js",
    "start:hamravesh": "node hamravesh/hamravesh-monitor.js",
    "start:hamravesh:monitor": "node hamravesh/hamravesh-monitor.js",
    "start:hamravesh:export": "node hamravesh/export-hamravesh-session.mjs",
    "hamravesh:export-session": "node hamravesh/export-hamravesh-session.mjs",
    "docker": "docker-compose up --build -d"
  },
  "author": "Arvan & Hamravesh Wallet Monitoring Team",
  "license": "UNLICENSED",
  "dependencies": {
    "axios": "^1.10.0",
